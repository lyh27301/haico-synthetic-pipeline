{"name": "sql_database", "args": {"query": "-- Create the cleaned_measurements table excluding outliers\nCREATE TABLE cleaned_measurements AS\nSELECT \n    session_id,\n    participant_id,\n    condition,\n    cognitive_score,\n    reaction_ms,\n    recorded_at,\n    status,\n    notes\nFROM measurements m\nWHERE NOT EXISTS (\n    WITH bounds AS (\n        SELECT \n            78.0 AS Q1_cog,\n            86.0 AS Q3_cog,\n            285.0 AS Q1_react,\n            355.0 AS Q3_react\n    )\n    SELECT 1\n    FROM bounds b, measurements m2\n    WHERE m2.session_id = m.session_id\n    AND (\n        -- cognitive_score outlier: values outside [lower_bound, upper_bound]\n        m2.cognitive_score < b.Q1_cog - 1.5 * (b.Q3_cog - b.Q1_cog)\n        OR m2.cognitive_score > b.Q3_cog + 1.5 * (b.Q3_cog - b.Q1_cog)\n        -- reaction_ms outlier: values outside [lower_bound, upper_bound]\n        OR m2.reaction_ms < b.Q1_react - 1.5 * (b.Q3_react - b.Q1_react)\n        OR m2.reaction_ms > b.Q3_react + 1.5 * (b.Q3_react - b.Q1_react)\n    )\n);", "database": "research_db"}, "result": {"results": [], "success": true}, "error": null}
