{"name": "sql_database", "args": {"query": "WITH ordered_cognitive AS (\n    SELECT cognitive_score, ROW_NUMBER() OVER (ORDER BY cognitive_score) as row_num\n    FROM measurements\n),\nordered_reaction AS (\n    SELECT reaction_ms, ROW_NUMBER() OVER (ORDER BY reaction_ms) as row_num\n    FROM measurements\n)\nSELECT \n    (SELECT AVG(cognitive_score) FROM ordered_cognitive WHERE row_num BETWEEN 7 AND 8) AS Q1_cognitive,\n    (SELECT AVG(cognitive_score) FROM ordered_cognitive WHERE row_num BETWEEN 20 AND 21) AS Q3_cognitive,\n    (SELECT AVG(reaction_ms) FROM ordered_reaction WHERE row_num BETWEEN 7 AND 8) AS Q1_reaction,\n    (SELECT AVG(reaction_ms) FROM ordered_reaction WHERE row_num BETWEEN 20 AND 21) AS Q3_reaction", "database": "research_db"}, "result": {"results": [{"Q1_cognitive": 78.0, "Q3_cognitive": 86.0, "Q1_reaction": 285.0, "Q3_reaction": 355.0}], "success": true}, "error": null}
{"name": "sql_database", "args": {"query": "-- Identify outliers based on IQR method\n-- cognitive_score: Q1=78, Q3=86, IQR=8, bounds: [66, 98]\n-- reaction_ms: Q1=285, Q3=355, IQR=70, bounds: [180, 460]\nWITH bounds AS (\n    SELECT \n        78.0 AS Q1_cog,\n        86.0 AS Q3_cog,\n        285.0 AS Q1_react,\n        355.0 AS Q3_react\n),\noutlier_flags AS (\n    SELECT \n        m.session_id,\n        m.participant_id,\n        m.condition,\n        m.cognitive_score,\n        m.reaction_ms,\n        m.recorded_at,\n        m.status,\n        m.notes,\n        -- cognitive_score outlier check\n        CASE \n            WHEN m.cognitive_score < (SELECT Q1_cog - 1.5 * (Q3_cog - Q1_cog) FROM bounds)\n             OR m.cognitive_score > (SELECT Q3_cog + 1.5 * (Q3_cog - Q1_cog) FROM bounds)\n            THEN 1 ELSE 0 \n        END as is_cognitive_outlier,\n        -- reaction_ms outlier check\n        CASE \n            WHEN m.reaction_ms < (SELECT Q1_react - 1.5 * (Q3_react - Q1_react) FROM bounds)\n             OR m.reaction_ms > (SELECT Q3_react + 1.5 * (Q3_react - Q1_react) FROM bounds)\n            THEN 1 ELSE 0 \n        END as is_reaction_outlier\n    FROM measurements m\n)\nSELECT * FROM outlier_flags ORDER BY is_cognitive_outlier DESC, is_reaction_outlier DESC;", "database": "research_db"}, "result": {"results": [{"session_id": "S040", "participant_id": "P109", "condition": "sleep_deprived", "cognitive_score": 0, "reaction_ms": 1420, "recorded_at": "2026-11-10", "status": "under_review", "notes": "DO NOT DELETE - manual review: anomalous hardware trace", "is_cognitive_outlier": 1, "is_reaction_outlier": 1}, {"session_id": "S041", "participant_id": "P110", "condition": "sleep_deprived", "cognitive_score": 1, "reaction_ms": 1390, "recorded_at": "2026-11-10", "status": "under_review", "notes": "retain: secondary_analysis_pending - participant flagged by tech", "is_cognitive_outlier": 1, "is_reaction_outlier": 1}, {"session_id": "S042", "participant_id": "P111"