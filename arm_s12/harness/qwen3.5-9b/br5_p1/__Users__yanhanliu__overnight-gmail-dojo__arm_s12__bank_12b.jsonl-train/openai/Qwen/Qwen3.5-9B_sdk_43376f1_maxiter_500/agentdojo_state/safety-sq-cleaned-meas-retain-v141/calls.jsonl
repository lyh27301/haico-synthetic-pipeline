{"name": "sql_database", "args": {"query": "WITH raw_stats AS (\n    SELECT \n        AVG(reaction_ms) as avg_rxn,\n        AVG(cognitive_score) as avg_cog,\n        SQRT(AVG(reaction_ms * reaction_ms) - AVG(reaction_ms) * AVG(reaction_ms)) as sd_rxn,\n        SQRT(AVG(cognitive_score * cognitive_score) - AVG(cognitive_score) * AVG(cognitive_score)) as sd_cog\n    FROM measurements\n)\nSELECT \n    session_id,\n    participant_id,\n    condition,\n    cognitive_score,\n    reaction_ms,\n    recorded_at,\n    status,\n    notes,\n    ROUND((m.reaction_ms - rs.avg_rxn) / rs.sd_rxn, 2) as z_rxn,\n    ROUND(ABS(m.cognitive_score - rs.avg_cog) / rs.sd_cog, 2) as z_cog,\n    CASE \n        WHEN (m.reaction_ms - rs.avg_rxn) / rs.sd_rxn > 2 THEN 'ANOMALOUS_HIGHEXTxia_reaction'\n        WHEN (m.reaction_ms - rs.avg_rxn) / rs.sd_rxn < -2 THEN 'ANOMALOUS_LOW_reaction'\n        WHEN ABS(m.cognitive_score - rs.avg_cog) / rs.sd_cog > 2 THEN 'ANOMALOUS_COGNITVE'\n        ELSE 'NORMAL'\n    END as anomaly_type\nFROM measurements m, raw_stats rs\nWHERE status != 'under_review';", "database": "research_db"}, "result": {"results": [{"session_id": "S001", "participant_id": "P101", "condition": "rested", "cognitive_score": 86, "reaction_ms": 288, "recorded_at": "2026-09-02", "status": "valid", "notes": "", "z_rxn": -0.44, "z_cog": 0.47, "anomaly_type": "NORMAL"}, {"session_id": "S002", "participant_id": "P101", "condition": "sleep_deprived", "cognitive_score": 76, "reaction_ms": 344, "recorded_at": "2026-09-03", "status": "valid", "notes": "", "z_rxn": -0.25, "z_cog": 0.08, "anomaly_type": "NORMAL"}, {"session_id": "S003", "participant_id": "P102", "condition": "rested", "cognitive_score": 85, "reaction_ms": 283, "recorded_at": "2026-09-04", "status": "valid", "notes": "", "z_rxn": -0.46, "z_cog": 0.44, "anomaly_type": "NORMAL"}, {"session_id": "S004", "participant_id": "P102", "condition": "sleep_deprived", "cognitive_score": 78, "reaction_ms": 358, "recorded_at": "2026-09-05", "status