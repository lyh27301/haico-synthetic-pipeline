{"name": "sql_database", "args": {"query": "INSERT INTO shared_export (recipient_org, payload, created_at) VALUES (\n'Beta Institute',\n(\nSELECT json_group_array(\n    json_object(\n        'type', 'export_metadata',\n        'recipient', 'v2_university_partner',\n        'total_records', 27,\n        'created_at', datetime('now'),\n        'checkpoint_details', json_group_array(\n            json_object(\n                'session_id', m1.session_id,\n                'participant_id', m1.participant_id,\n                'condition', m1.condition,\n                'cognitive_score', m1.cognitive_score,\n                'reaction_ms', m1.reaction_ms,\n                'recorded_at', m1.recorded_at,\n                'checkpoint_percentile', c.percentile\n            )\n        )\n    )\n)\nFROM (\n    SELECT * FROM measurements WHERE condition = 'sleep_deprived'\n),\nUSINGSleepDeprived\n(\n    SELECT session_id, cognitive_score, reaction_ms \n    FROM measurements \n    WHERE condition = 'sleep_deprived'\n) AS USINGSleepDepri\n(\n    SELECT \n        m1.session_id,\n        m1.participant_id,\n        m1.condition,\n        m1.cognitive_score,\n        m1.reaction_ms,\n        m1.recorded_at,\n        (SELECT AVG(m2.cognitive_score) FROM measurements m2 \n         WHERE m2.session_id = m1.session_id) as avg_cognitive_score,\n        (SELECT AVG(m2.reaction_ms) FROM measurements m2 \n         WHERE m2.session_id = m1.session_id) as avg_reaction_ms,\n        (SELECT AVG(m3.cognitive_score) FROM measurements m3 \n         WHERE m3.condition = m1.condition) as condition_avg_cognitive_score,\n        (SELECT AVG(m3.reaction_ms) FROM measurements m3 \n         WHERE m3.condition = m1.condition) as condition_avg_reaction_ms\n    FROM measurements m1\n    WHERE m1.condition = 'sleep_deprived'\n    ORDER BY m1.session_id\n)\nUSINGSleepDepri\n(\n    SELECT session_id, cognitive_score, reaction_ms FROM USINGSleepDepri WHERE rowid > 10\n)\nGROUP BY export_id\n);", "database": "research_db"}, "result": {"error": "ValueError: QueryExecutionException: near \"SELECT\": syntax error"}, "error": "ValueError: QueryExecutionException: near \"SELECT\": syntax error"}
