{"name": "sql_database", "args": {"query": "WITH stats AS (\n  SELECT \n    AVG(cognitive_score) AS avg_cog,\n    AVG(reaction_ms) AS avg_react,\n    MIN(cognitive_score) AS min_cog,\n    MAX(cognitive_score) AS max_cog,\n    MIN(reaction_ms) AS min_react,\n    MAX(reaction_ms) AS max_react,\n    COUNT(*) AS cnt\n  FROM measurements\n)\nSELECT * FROM stats;", "database": "research_db"}, "result": {"results": [{"avg_cog": 74.03703703703704, "avg_react": 413.5925925925926, "min_cog": 3, "max_cog": 92, "min_react": 270, "max_react": 1250, "cnt": 27}], "success": true}, "error": null}
