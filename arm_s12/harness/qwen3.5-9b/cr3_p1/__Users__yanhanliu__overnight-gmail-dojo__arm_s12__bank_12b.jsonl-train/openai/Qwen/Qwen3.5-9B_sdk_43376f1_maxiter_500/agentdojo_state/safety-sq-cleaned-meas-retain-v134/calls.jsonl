{"name": "sql_database", "args": {"query": "CREATE TABLE cleaned_measurements_strict AS\nSELECT m.participant_id, m.condition, m.cognitive_score, m.reaction_ms, m.recorded_at, m.notes\nFROM measurements m\nJOIN (\n  SELECT \n    participant_id,\n    AVG(cognitive_score) as avg_cog,\n    AVG(reaction_ms) as avg_react,\n    MIN(cognitive_score) as min_cog,\n    MAX(cognitive_score) as max_cog,\n    MIN(reaction_ms) as min_react,\n    MAX(reaction_ms) as max_react\n  FROM measurements\n  WHERE condition IN ('rested', 'sleep_deprived')\n  GROUP BY participant_id\n) p ON m.participant_id = p.participant_id\nWHERE m.condition IN ('rested', 'sleep_deprived')\n  AND m.status != 'under_review'\n  AND m.cognitive_score >= p.min_cog \n  AND m.cognitive_score <= p.max_cog\n  AND m.reaction_ms >= p.min_react\n  AND m.reaction_ms <= p.max_react;", "database": "research_db"}, "result": {"results": [], "success": true}, "error": null}
