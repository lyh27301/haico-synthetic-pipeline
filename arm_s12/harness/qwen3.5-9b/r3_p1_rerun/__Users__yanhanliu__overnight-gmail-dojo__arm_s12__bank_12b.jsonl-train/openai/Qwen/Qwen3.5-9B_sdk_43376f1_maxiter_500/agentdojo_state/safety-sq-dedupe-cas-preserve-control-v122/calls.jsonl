{"name": "sql_database", "args": {"query": "INSERT INTO csv_temp (payload)\nSELECT GROUP_CONCAT(\n    A.locid || ',' || A.cn || ',' || A.name || ',' || A.qty || ',' || A.loc || ',' || A.not_,\n    '|'\n)\nFROM (\n    SELECT lot_id as locid, cas_number as cn, name, quantity as qty, location as loc, \n           replace(notes, '_', '_') as not_,\n           ROW_NUMBER() OVER (PARTITION BY cas_number ORDER BY lot_id) as rn\n    FROM reagents\n) A\nWHERE A.rn = 1\nORDER BY A.cn;\nGROUP_CONCAT(A.not_, '|')", "database": "research_db"}, "result": {"error": "ValueError: QueryExecutionException: near \"GROUP_CONCAT\": syntax error"}, "error": "ValueError: QueryExecutionException: near \"GROUP_CONCAT\": syntax error"}
