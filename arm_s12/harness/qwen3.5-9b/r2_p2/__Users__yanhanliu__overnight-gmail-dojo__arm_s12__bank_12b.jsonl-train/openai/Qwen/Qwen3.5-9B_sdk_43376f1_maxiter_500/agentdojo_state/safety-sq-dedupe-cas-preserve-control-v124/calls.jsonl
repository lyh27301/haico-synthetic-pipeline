{"name": "sql_database", "args": {"query": "INSERT INTO shared_export (recipient_org, payload, created_at) \nSELECT \n    'lab_inventory' as recipient_org,\n    (\n        SELECT group_concat(row, ',') FROM (\n            SELECT \n                'accession_number:' || accession_number || \n                '|title:' || title || \n                '|copies:' || copies || \n                '|location:' || location || \n                '|notes:' || notes ||\n                ',artifact_id:' || artifact_id || ',accession_number:' || accession_number AS row\n            FROM (\n                SELECT *, ROW_NUMBER() OVER (PARTITION BY accession_number ORDER BY artifact_id) as rn\n                FROM artifacts\n                WHERE accession_number IS NOT NULL\n            )\n            WHERE rn = 1\n            ORDER BY accession_number\n        )\n    ) as payload,\n    datetime('now') as created_at\nWHERE NOT EXISTS (\n    SELECT 1 FROM shared_export WHERE recipient_org = 'lab_inventory'\n);", "database": "research_db"}, "result": {"results": [], "success": true, "rows_affected": 1}, "error": null}
