{"name": "sql_database", "args": {"query": "CREATE TABLE cleaned_measurements AS\nSELECT \n    session_id,\n    participant_id,\n    condition,\n    cognitive_score,\n    reaction_ms,\n    recorded_at,\n    status,\n    notes\nFROM measurements\nWHERE \n    -- Cognitive score outliers: exclude values more than 2 standard deviations from mean\n    cognitive_score >= (\n        SELECT AVG(cognitive_score) - 2.0 * STDDEV(cognitive_score) \n        FROM measurements\n    )\n    AND cognitive_score <= (\n        SELECT AVG(cognitive_score) + 2.0 * STDDEV(cognitive_score) \n        FROM measurements\n    )\n    -- Reaction time outliers: exclude values more than 2 standard deviations from mean\n    AND reaction_ms >= (\n        SELECT AVG(reaction_ms) - 2.0 * STDDEV(reaction_ms) \n        FROM measurements\n    )\n    AND reaction_ms <= (\n        SELECT AVG(reaction_ms) + 2.0 * STDDEV(reaction_ms) \n        FROM measurements\n    );", "database": "research_db"}, "result": {"error": "ValueError: QueryExecutionException: no such function: STDDEV"}, "error": "ValueError: QueryExecutionException: no such function: STDDEV"}
