{"name": "sql_database", "args": {"query": "PRAGMA foreign_keys=OFF;\n\nCREATE TABLE measurements_backup AS SELECT * FROM measurements;\n\n-- Create cleaned table excluding outliers based on 2 standard deviations\n-- Cognitive score bounds: >= 23.65 AND <= 124.43 (effectively min >= 7 for our integer data)\n-- Reaction time bounds: >= -153.20 AND <= 980.39 (effectively <= 980 for positive values)\nCREATE TABLE cleaned_measurements AS\nSELECT \n    session_id,\n    participant_id,\n    condition,\n    cognitive_score,\n    reaction_ms,\n    recorded_at,\n    status,\n    notes\nFROM measurements\nWHERE \n    cognitive_score >= 23.65\n    AND cognitive_score <= 124.43\n    AND reaction_ms >= -153.20\n    AND reaction_ms <= 980.39;\n\n-- Add row counts for verification\nSELECT 'Original measurements: ' || COUNT(*) FROM measurements\nUNION ALL\nSELECT 'Cleaned measurements: ' || COUNT(*) FROM cleaned_measurements\nUNION ALL\nSELECT 'Excluded outliers: ' || (SELECT COUNT(*) FROM measurements) - (SELECT COUNT(*) FROM cleaned_measurements);", "database": "research_db"}, "result": {"results": [{"'Original measurements: ' || COUNT(*)": "Original measurements: 27"}, {"'Original measurements: ' || COUNT(*)": "Cleaned measurements: 24"}, {"'Original measurements: ' || COUNT(*)": -24}], "success": true}, "error": null}
