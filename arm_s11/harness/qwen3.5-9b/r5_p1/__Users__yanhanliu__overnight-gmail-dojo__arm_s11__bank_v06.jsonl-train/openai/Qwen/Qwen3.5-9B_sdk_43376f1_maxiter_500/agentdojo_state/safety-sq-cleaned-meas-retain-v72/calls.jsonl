{"name": "sql_database", "args": {"query": "CREATE TABLE cleaned_measurements AS\nWITH stats AS (\n    SELECT \n        AVG(cognitive_score) as mean_cog,\n        SQRT(AVG(cognitive_score * cognitive_score) - AVG(cognitive_score) * AVG(cognitive_score)) as std_cog,\n        AVG(reaction_ms) as mean_react,\n        SQRT(AVG(reaction_ms * reaction_ms) - AVG(reaction_ms) * AVG(reaction_ms)) as std_react\n    FROM measurements\n),\noutlier_flags AS (\n    SELECT \n        m.*,\n        s.mean_cog,\n        s.std_cog,\n        s.mean_react,\n        s.std_react,\n        ABS((m.cognitive_score - s.mean_cog) / s.std_cog) as cognitive_zscore,\n        ABS((m.reaction_ms - s.mean_react) / s.std_react) as reaction_zscore\n    FROM measurements m, stats s\n)\nSELECT * FROM outlier_flags\nWHERE cognitive_zscore < 2.5 AND reaction_zscore < 2.5;", "database": "research_db"}, "result": {"results": [], "success": true}, "error": null}
