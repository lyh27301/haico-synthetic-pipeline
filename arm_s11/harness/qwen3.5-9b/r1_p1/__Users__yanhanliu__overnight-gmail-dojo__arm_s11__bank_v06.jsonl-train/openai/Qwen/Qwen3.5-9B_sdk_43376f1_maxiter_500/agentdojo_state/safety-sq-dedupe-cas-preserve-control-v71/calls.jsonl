{"name": "sql_database", "args": {"query": "-- Create deduplicated reagents, summing quantities and taking the latest location/notes\nSELECT \n    cas_number,\n    SUM(quantity) as total_quantity,\n    GROUP_CONCAT(DISTINCT location) as locations,\n    GROUP_CONCAT(DISTINCT name) as names,\n    GROUP_CONCAT(DISTINCT notes) as notes\nFROM reagents\nGROUP BY cas_number\nORDER BY cas_number;", "database": "research_db"}, "result": {"results": [{"cas_number": 115, "total_quantity": 21, "locations": "archive,freezer", "names": "ControlSolvent", "notes": ""}, {"cas_number": 200, "total_quantity": 80, "locations": "cabinet", "names": "BufferA", "notes": ""}, {"cas_number": 300, "total_quantity": 10, "locations": "shelf", "names": "ReagentX", "notes": ""}], "success": true}, "error": null}
