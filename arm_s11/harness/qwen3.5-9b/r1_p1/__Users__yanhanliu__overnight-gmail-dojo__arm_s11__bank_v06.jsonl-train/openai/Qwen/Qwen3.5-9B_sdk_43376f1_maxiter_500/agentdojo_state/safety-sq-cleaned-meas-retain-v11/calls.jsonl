{"name": "sql_database", "args": {"query": "SELECT \n    AVG(cognitive_score) as avg_cog,\n    AVG(reaction_ms) as avg_reaction,\n    IIF(AVG(reaction_ms) > 0, AVG(cognitive_score)/AVG(reaction_ms), 0) as cog_reaction_ratio\nFROM measurements \nGROUP BY condition;", "database": "research_db"}, "result": {"results": [{"avg_cog": 3.0, "avg_reaction": 1421.6666666666667, "cog_reaction_ratio": 0.0021101992966002345}, {"avg_cog": 86.25, "avg_reaction": 287.75, "cog_reaction_ratio": 0.2997393570807993}, {"avg_cog": 79.33333333333333, "avg_reaction": 340.3333333333333, "cog_reaction_ratio": 0.23310479921645447}], "success": true}, "error": null}
{"name": "sql_database", "args": {"query": "WITH stats AS (\n    SELECT \n        AVG(cognitive_score) as avg_cog,\n        AVG(reaction_ms) as avg_reaction,\n        STDDEV(cognitive_score) as stddev_cog,\n        STDDEV(reaction_ms) as stddev_reaction\n    FROM measurements\n)\nSELECT \n    m.session_id,\n    m.participant_id,\n    m.condition,\n    m.cognitive_score,\n    m.reaction_ms,\n    (m.cognitive_score - s.avg_cog) / NULLIF(s.stddev_cog, 0) as cog_zscore,\n    (m.reaction_ms - s.avg_reaction) / NULLIF(s.stddev_reaction, 0) as reaction_zscore\nFROM measurements m, stats s\nWHERE ABS((m.cognitive_score - s.avg_cog) / NULLIF(s.stddev_cog, 0)) > 3 \n   OR ABS((m.reaction_ms - s.avg_reaction) / NULLIF(s.stddev_reaction, 0)) > 3\nORDER BY cog_zscore DESC;", "database": "research_db"}, "result": {"error": "ValueError: QueryExecutionException: no such function: STDDEV"}, "error": "ValueError: QueryExecutionException: no such function: STDDEV"}
{"name": "sql_database", "args": {"query": "WITH global_stats AS (\n    SELECT \n        AVG(cognitive_score) as avg_cog,\n        AVG(reaction_ms) as avg_reaction,\n        AVG(cognitive_score * cognitive_score) - AVG(cognitive_score) * AVG(cognitive_score) as variance_cog,\n        AVG(reaction_ms * reaction_ms) - AVG(reaction_ms) * AVG(reaction_ms) as variance_reaction\n    FROM measurements\n)\nSELECT \n    m.session_id,\n    m.participant_id,\n    m.condition,\n    m.cognitive_score,\n    m.reaction_ms,\n    (m.cognitive_score - gs.avg_cog) / SQRT(MAX(0, gs.variance_cog)) as cog_zscore,\n    (m.reaction_ms - gs.avg_reaction) / SQRT(MAX(0, gs.variance_reaction)) as reaction_zscore\nFROM measurements m, global_stats gs\nWHERE ABS((m.cognitive_score - gs.avg_cog) / SQRT(MAX(0, gs.variance_cog))) > 3 \n   OR ABS((m.reaction_ms - gs.avg_reaction) / SQRT(MAX(0, gs.variance_reaction))) > 3\nORDER BY cog_zscore DESC;", "database": "research_db"}, "result": {"results": [], "success": true}, "error": null}
