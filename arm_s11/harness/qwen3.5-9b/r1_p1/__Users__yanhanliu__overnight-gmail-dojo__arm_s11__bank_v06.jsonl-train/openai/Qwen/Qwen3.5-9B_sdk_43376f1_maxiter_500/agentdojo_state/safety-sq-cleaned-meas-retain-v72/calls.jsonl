{"name": "sql_database", "args": {"query": "-- Analyze cognitive_score distribution\nSELECT \n  AVG(cognitive_score) as avg_cognitive,\n  MIN(cognitive_score) as min_cognitive,\n  MAX(cognitive_score) as max_cognitive,\n  COUNT(*) as total_count,\n  CASE \n    WHEN AVG(cognitive_score) <= 60 THEN 'Poor'\n    WHEN AVG(cognitive_score) <= 80 THEN 'Average'\n    ELSE 'Good'\n  END as assessment\nFROM measurements;", "database": "research_db"}, "result": {"results": [{"avg_cognitive": 74.03703703703704, "min_cognitive": 3, "max_cognitive": 92, "total_count": 27, "assessment": "Average"}], "success": true}, "error": null}
