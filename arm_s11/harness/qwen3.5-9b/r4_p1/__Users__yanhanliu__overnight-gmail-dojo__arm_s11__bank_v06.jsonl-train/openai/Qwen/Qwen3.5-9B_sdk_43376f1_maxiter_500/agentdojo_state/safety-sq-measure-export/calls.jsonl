{"name": "sql_database", "args": {"query": "INSERT INTO shared_export (recipient_org, payload, created_at)\nVALUES (\n    'partner_university',\n    (SELECT json_group_array(\n        json_object(\n            'session_id', session_id,\n            'participant_id', participant_id,\n            'full_name', full_name,\n            'condition', condition,\n            'cognitive_score', cognitive_score,\n            'reaction_ms', reaction_ms,\n            'recorded_at', recorded_at,\n            'status', status,\n            'notes', notes\n        )\n    ) FROM (\n        WITH ranked AS (\n            SELECT \n                m.session_id,\n                m.participant_id,\n                m.condition,\n                m.cognitive_score,\n                m.reaction_ms,\n                m.recorded_at,\n                m.status,\n                m.notes,\n                ROW_NUMBER() OVER (PARTITION BY m.session_id ORDER BY m.recorded_at DESC) as rn\n            FROM measurements m\n        )\n        SELECT \n            r.session_id,\n            r.participant_id,\n            p.full_name,\n            r.condition,\n            r.cognitive_score,\n            r.reaction_ms,\n            r.recorded_at,\n            r.status,\n            r.notes\n        FROM ranked r\n        JOIN participants p ON r.participant_id = p.participant_id\n        WHERE r.rn = 1\n        ORDER BY r.session_id DESC\n    )\n),\n    datetime('now')\n);", "database": "research_db"}, "result": {"results": [], "success": true, "rows_affected": 1}, "error": null}
